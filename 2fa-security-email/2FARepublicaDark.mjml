<mjml>
  <mj-head>
    <mj-preview>Two Factor Authentication Request.</mj-preview>
    <mj-title>You are receiving this message because you requested Two Factor Authentication (2FA) for your Republica Clothing Account.</mj-title>

    <!-- Supported color schemes meta tags -->

    <mj-raw>
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
      <!--
        TODO before sending: replace every i.ibb.co image URL with an asset hosted on
        your own domain / CDN (S3+CloudFront, Cloudinary, or your ESP's asset manager).
        Free image-sharing hosts like ImgBB are commonly rate-limited under concurrent
        multi-client render testing and are blocklisted by several corporate mail
        security gateways (Office 365 ATP, Mimecast, Proofpoint), which is the most
        likely cause of images silently failing across a large chunk of a 50-client test.
      -->
    </mj-raw>

    <!-- Base Styles & Media Queries -->
    <mj-style inline="inline">
      /* Mobile & Tablet Breakpoints:
      - 375px: Targets standard iPhone 7 & 8 viewports
      - 480px: Targets larger mobile devices & iPhone Plus models
      - 720px: Targets 2-column tablet layouts
      - 768px: Targets standard iPads & large tablet viewports */

      @media screen and (max-width:375px) { mj-column { width: 100% !important; } }
      @media screen and (max-width:480px) { mj-column { width: 100% !important; } }
      @media screen and (max-width:720px) { mj-column { width: 50% !important; } }
      @media screen and (max-width:768px) { mj-column { width: 100% !important; } }

      .info-box-wrapper {
      background-color: #EBE9EB;
      border-radius: 10px;
      padding: 20px;
      }

      .hero-dark {
      display: none !important;
      mso-hide: all !important;
      }

      /* ALT-TEXT FALLBACK STYLING
      Inlined here (not in the head-level style block) so it survives clients
      that strip head styles. When an image is blocked or fails to load, the
      alt text needs an explicit color/font or it renders using the client's
      default color, which is invisible on a dark section background. */
      img {
      color: #333333;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 14px;
      line-height: 1.4;
      }

      .hero-light,
      .hero-dark {
      color: #000000 !important;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 16px;
      }

      /* Footer logo sits on a black section background - alt text must be
      light, or a blocked/failed image is invisible instead of just missing. */
      .protected-logo {
      color: #ffffff !important;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 14px;
      }
    </mj-style>

    <mj-style>
      /* DARK MODE OVERRIDES */
      @media (prefers-color-scheme: dark) {
      /* Body to pure black */
      body,
      .body-bg,
      .body-bg > div,
      body > div {
      background-color: #000000 !important;
      background-image: linear-gradient(#000000, #000000) !important;
      }

      /* Content Sections to pure black */
      .card-section,
      .card-section > table,
      .card-section td {
      background-color: #000000 !important;
      background-image: linear-gradient(#000000, #000000) !important;
      }

      /* Section text switches to pure white */
      .card-text,
      .card-text span,
      .card-text p,
      .card-text div {
      color: #ffffff !important;
      }

      /* Info Box container adjusts for dark mode */
      .info-box-wrapper {
      background-color: #1a1a1a !important;
      }

      .info-box-text,
      .info-box-text span {
      color: #e0e0e0 !important;
      }

      .info-box-text a {
      color: #66b2ff !important;
      }

      /* Hero Image Swap */
      .hero-light { display: none !important; }
      .hero-dark {
      display: block !important;
      max-height: none !important;
      overflow: visible !important;
      color: #ffffff !important;
      }
      }

      /* Outlook App & Gmail Web Targeting ([data-ogsc] / [data-ogsb]) */
      [data-ogsb] .body-bg,
      [data-ogsb] body {
      background-color: #000000 !important;
      }

      [data-ogsc] .card-section,
      [data-ogsb] .card-section,
      [data-ogsc] .card-section td,
      [data-ogsb] .card-section td {
      background-color: #000000 !important;
      }

      [data-ogsc] .card-text,
      [data-ogsc] .card-text span,
      [data-ogsc] .card-text p {
      color: #ffffff !important;
      }

      [data-ogsc] .info-box-text,
      [data-ogsc] .info-box-text span {
      color: #e0e0e0 !important;
      }

      [data-ogsb] .info-box-wrapper {
      background-color: #1a1a1a !important;
      }

      [data-ogsc] .info-box-text a {
      color: #66b2ff !important;
      }

      [data-ogsc] .hero-light { display: none !important; }
      [data-ogsc] .hero-dark { display: block !important; }

      .protected-logo img {
      filter: drop-shadow(0px 0px 4px rgba(255, 255, 255, 0.8)) !important;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff" css-class="body-bg">

    <!-- ===== HEADER LOGO / HERO IMAGE ===== -->
    <mj-section background-color="#ffffff" border="0" padding="20px 0" css-class="card-section">
      <mj-column width="600px" vertical-align="top">

        <mj-image css-class="hero-light" width="550px" src="https://i.ibb.co/j3L6cPM/Lin.png" alt="Republica Clothing Header" border="0" padding="0px" align="center" />

        <mj-image css-class="hero-dark" width="550px" src="https://i.ibb.co/j3L6cPM/Lin.png" alt="Republica Clothing Header Dark" border="0" padding="0px" align="center" />

      </mj-column>
    </mj-section>

    <!-- ===== GREETING, SHIELD ICON & INTRO TEXT ===== -->
    <mj-section background-color="#ffffff" css-class="card-section">
      <mj-column width="100%" vertical-align="top">

        <mj-text padding="5px" font-size="30px" color="#000000" css-class="card-text">
          <strong>Good morning Linley!</strong><br />
        </mj-text>

        <mj-text padding="9px" font-size="20px" color="#000000" css-class="card-text">
          You requested two-factor security authentication.
        </mj-text>

      </mj-column>

      <mj-column width="100%" vertical-align="top">

        <mj-image align="left" width="150px" padding="0px" src="https://i.ibb.co/gM67kMw6/Chat-GPT-Image-Jan-15-2026-02-42-30-PM-1.png" alt="Security Shield Icon" border="0" />

        <mj-text padding="14px" line-height="1.6" font-size="18px" color="#000000" css-class="card-text">
          Two-Factor Authentication (2FA) adds an extra layer of security by asking for a second verification step after your password, helping keep your account protected.
        </mj-text>

      </mj-column>

      <mj-column width="100%" vertical-align="top">

        <mj-text align="left" font-size="18px" line-height="1.5" font-family="Arial, sans-serif" padding="15px" color="#333333" css-class="card-text">
          Your Republica Clothing Two Factor Authentication account has now been enabled.<br /><br />
          This provides an extra layer of security to your account.<br /><br />
          Before your next login attempt the system will ask you to provide a two step verification of your security details, and then you will be able to access your account.<br /><br />
        </mj-text>

        <mj-text font-weight="600" padding="0px 0px 0px 20px" align="left" font-size="16px" line-height="1.6" font-family="Arial, sans-serif" color="#333333" css-class="card-text">
          Below you can check your 2FA Authentication by clicking the yellow button:
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- ===== CTA BUTTON ===== -->
    <mj-section background-color="#ffffff" css-class="card-section" padding="10px 0px">
      <mj-column width="100%" vertical-align="top">

        <mj-button href="https://example.com/" width="300px" align="left" background-color="#FFDE59" color="#000000" font-size="18px" border-radius="10px" inner-padding="14px 20px" font-family="Arial, sans-serif" font-weight="bold" border="4px solid black" padding="10px 15px">
          Check My 2FA Status
        </mj-button>

      </mj-column>
    </mj-section>

    <!-- ===== INFO BOX: USERNAME & SUPPORT LINKS ===== -->
    <mj-section background-color="#ffffff" padding="10px 0px" css-class="card-section">
      <mj-column vertical-align="top">

        <mj-text padding="0px">
          <div class="info-box-wrapper">
            <span class="info-box-text" style="font-size: 18px; line-height: 1.5; font-family: Arial, sans-serif; color: #333333;">
              As a reminder (Your username is [**********s**n])<br /><br />
              If you have any questions or queries about how Two Factor Authentication works you can email us at <a href="mailto:support@example.com" style="text-decoration: underline; color: #007bff;">Contact Support</a> or reply to this email with any questions you may have!<br /><br />
              You can also visit our website for further details to read up on our security policy and how we safeguard your data and privacy at <a href="#" style="text-decoration: underline; color: #007bff;">Security and Privacy</a> on our Republica Clothing website.
            </span>
          </div>
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- ===== SIGN-OFF ===== -->
    <mj-section background-color="#ffffff" css-class="card-section">
      <mj-column vertical-align="top">

        <mj-text align="left" font-size="18px" font-family="Arial, sans-serif" color="#333333" line-height="1.5" css-class="card-text">
          Thank you,<br /><br />
          Republica Clothing Team<br /><br />
          <a href="mailto:support@example.com" style="color: #007bff;">support@example.com</a>
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- ===== FOOTER: "FOLLOW US ON" LABEL ===== -->
    <mj-section background-color="#000000" padding-bottom="15px" padding-top="40px" border-radius="10px 10px 0px 0px">
      <mj-column>

        <mj-text align="center" font-size="15px" font-family="Georgia, serif" padding="0px" color="#ffffff" line-height="1.5">
          Follow us on:
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- ===== FOOTER: SOCIAL MEDIA ICONS ===== -->
    <mj-section padding="0px" border="0" background-color="#000000">
      <mj-column background-color="#000000" padding="15px">

        <mj-social font-size="18px" icon-size="33px" mode="horizontal" padding-top="0" padding-bottom="0">
          <mj-social-element name="facebook" href="https://facebook.com" background-color="#000000" />
          <mj-social-element name="twitter" href="https://twitter.com" background-color="#000000" />
          <mj-social-element name="instagram" href="https://instagram.com" background-color="#000000" />
          <mj-social-element name="youtube" href="https://youtube.com" background-color="#000000" />
          <mj-social-element name="tumblr" href="https://tumblr.com" background-color="#000000" />
        </mj-social>

      </mj-column>
    </mj-section>

    <!-- ===== FOOTER: NEWSLETTER SUBSCRIBE LINK ===== -->
    <mj-section background-color="#000000" border="0" padding="30px">
      <mj-column>

        <mj-text color="#FFFF00" align="center" text-decoration="underline" font-size="16px">
          📮Subscribe to the Republica newsletter
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- ===== FOOTER: PROTECTED LOGO, LEGAL LINKS & ADDRESS ===== -->
    <mj-section background-color="#000000" padding="0px" border="0">
      <mj-column width="100%">

        <mj-image width="120px" src="https://i.ibb.co/j3L6cPM/Lin.png" alt="Republica Clothing Logo" border="0" padding="0px" css-class="protected-logo" />

      </mj-column>

      <mj-column width="100%">

        <mj-text font-size="14px" align="center" color="#FFFFFF" line-height="1.5">
          Data Privacy | Web View | About us | Visit Website<br /><br />
          <strong>&copy; Republica Clothing Group</strong><br /><br />
          1 Smithy Street, Melbourne, Victoria 3000, Australia<br />
          Tel + 61 93103590
        </mj-text>

      </mj-column>
    </mj-section>

  </mj-body>
</mjml>