<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Set up account notification.</mj-title>
    <mj-preview>Set up your online account with Kick off → Your English</mj-preview>
  </mj-head>
  <mj-body background-color="orange">

    <!-- Header: brand name and logo -->
    <mj-section background-color="#FFF" border="0" padding="0">
      <mj-column width="50%">
        <mj-text padding-top="56px" align="center" color="#000" font-size="42px">
          <span style="color:orange; line-height:2.0;"><strong>Kick&nbsp;</strong></span>off → Your English!
        </mj-text>
      </mj-column>
      <mj-column width="50%">
        <mj-image width="250px" align="left" src="https://i.ibb.co/dQfhpdk/Screenshot-2024-04-04-100812-Photoroom-png-Photoroom-2.png" alt="Kick off → Your English logo" border="0" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Hero image -->
    <mj-section background-color="#FFF" border="0" padding="0">
      <mj-column width="600px">
        <mj-image width="600px" src="https://i.ibb.co/gLvMgj3Z/Gemini-Generated-Image-ehknlgehknlgehkn.png" alt="Kick off → Your English illustration" border="0" padding="0" border-radius="20px" />
      </mj-column>
    </mj-section>

    <!-- Main text. Greeting uses params.firstName, with a fallback when it is missing or empty -->
    <mj-section padding="10px" background-color="#FFF" border="0">
      <mj-column>
        <mj-text align="left" font-family="Georgia, serif" font-size="26px" line-height="1.5"><strong>Set Up Your Online Account</strong></mj-text>
        <mj-text align="left" font-size="18px" line-height="1.5" font-family="Arial, sans-serif" color="#333">
          {% if params.firstName %}Hi {{ params.firstName }},{% else %}Hi there,{% endif %}<br /><br />
          Now that you have signed up with us via your email address and phone number you can easily set up your online account with us.<br /><br />
          Your <strong>Kick off → Your English</strong> account will give you quick and no fuss access to your English class plans and you can make changes or update to your account details.<br /><br />
          You can also download your progress reports and change English class plans and a lot more!<br /><br />
          <strong>Let's get you set up!</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Plan and first classes. Only shown when "plan" is sent. mj-raw lets the Brevo tags sit between MJML tags -->
    <mj-raw>{% if params.plan %}</mj-raw>
    <mj-section padding="0 10px 10px 10px" background-color="#FFF" border="0">
      <mj-column background-color="#f2f2f2" border-radius="10px" padding="15px">
        <mj-text align="left" font-size="18px" line-height="1.5" font-family="Arial, sans-serif" color="#333">
          {% if params.plan.name %}<strong>Your plan:</strong> {{ params.plan.name }}<br />{% endif %}
          {% if params.plan.classesPerWeek %}<strong>Classes per week:</strong> {{ params.plan.classesPerWeek }}{% endif %}
        </mj-text>
        <mj-raw>{% if params.classes %}</mj-raw>
        <mj-text align="left" font-size="16px" line-height="1.5" font-family="Arial, sans-serif" color="#333">
          <strong>Your first classes:</strong>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:8px; font-size:16px;">
            {% for c in params.classes %}
            <tr>
              <td style="padding:4px 0;">{{ c.day }}</td>
              <td style="padding:4px 0;">{{ c.time }}</td>
              <td style="padding:4px 0;">with {{ c.teacher }}</td>
            </tr>
            {% endfor %}
          </table>
        </mj-text>
        <mj-raw>{% endif %}</mj-raw>
      </mj-column>
    </mj-section>
    <mj-raw>{% endif %}</mj-raw>

    <!-- Button. The link comes from setupLink -->
    <mj-section padding="15px 15px 15px 12px" background-color="#fff" border="0">
      <mj-column background-color="#f2f2f2" border-radius="10px">
        <mj-button href="{{ params.setupLink }}" width="250px" align="left" background-color="blue" color="#FFF" font-size="22px" border-radius="5px" height="60px" font-family="Arial, sans-serif" font-weight="bold" border="0" padding="25px">
          Set Up Your Account
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Reminder and support -->
    <mj-section background-color="#FFF" padding="10px" border="0">
      <mj-column vertical-align="middle">
        <mj-text align="left" font-size="18px" line-height="1.6" font-family="Arial, sans-serif" color="#000">
          {% if params.linkExpiresInHours %}This link works for {{ params.linkExpiresInHours }} hours.<br /><br />{% endif %}As a reminder (the email registered with us is <strong>{{ params.maskedEmail }}</strong>).
          <br /><br />If you have any questions or queries about setting up your account you can email us at <a href="mailto:support@example.com" style="text-decoration: underline; color: #007bff;">Contact Support</a>. We will be glad to help you get set up.<br /><br />You can also visit our website for further details to read up on our security policy and how we safeguard your data and privacy at <a href="https://example.com/security-and-privacy" style="text-decoration: underline; color: #007bff;">Security and Privacy</a> on our website.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Sign-off -->
    <mj-section background-color="#FFF" padding="10px" border="0">
      <mj-column>
        <mj-text align="left" font-size="18px" font-family="Arial, sans-serif" color="#333" padding-bottom="30px">
          Thank you,<br />
          Customer Support Team<br />
          <a href="mailto:support@example.com" style="color:#007bff;">support@example.com</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Social links -->
    <mj-section background-color="#333" padding-bottom="5px" padding-top="40px" border="0">
      <mj-column>
        <mj-text align="center" font-size="16px" font-family="Georgia, serif" padding="0" color="#fff" line-height="1.5">Follow us on:</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0" border="0" background-color="#fff">
      <mj-column background-color="#333" padding-top="5px" padding-bottom="0" padding-left="5px" padding-right="5px">
        <mj-social font-size="18px" icon-size="33px" mode="horizontal" padding-top="0" padding-bottom="0" padding-left="25px" padding-right="25px">
          <mj-social-element name="facebook-noshare" href="https://www.facebook.com/" alt="Facebook" background-color="#333" color="#fff"></mj-social-element>
          <mj-social-element name="twitter-noshare" href="https://twitter.com/" alt="Twitter" background-color="#333" color="#fff"></mj-social-element>
          <mj-social-element name="instagram" href="https://www.instagram.com/" alt="Instagram" background-color="#333" color="#fff"></mj-social-element>
          <mj-social-element name="youtube" href="https://www.youtube.com/" alt="YouTube" background-color="#333" color="#fff"></mj-social-element>
        </mj-social>
      </mj-column>
    </mj-section>

    <!-- Subscribe text -->
    <mj-section background-color="#333" border="0" padding="20px">
      <mj-column>
        <mj-text line-height="1.5" color="#FFF" align="center" text-decoration="underline" font-size="18px">📮Subscribe to the Kick off → Your English weekly newsletter.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#333" padding="0px" border="0">
      <mj-column width="30%">
        <mj-image width="100px" align="right" src="https://i.ibb.co/VVvw5zs/Screenshot-2024-04-04-100812-Photoroom-png-Photoroom-2.png" alt="Kick off → Your English logo" border="0" padding="0" />
      </mj-column>
      <mj-column width="70%">
        <mj-text font-size="16px" align="left" color="#FFF" line-height="1.5" font-family="Arial, sans-serif" font-weight="bold" padding-bottom="0px"><strong>Kick</strong> off → is brought to you by:<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style="color: #FFF;">Geo English</span></mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#333" padding="15px" border="0">
      <mj-column>
        <mj-image src="https://i.ibb.co/sgn29Yk/Screenshot-2024-04-04-095719.png" alt="Geo English logo" border="0" padding="0" css-class="responsive-image" width="100px" height="100px" border-radius="160px" />
      </mj-column>
    </mj-section>

    <!-- Company address -->
    <mj-section background-color="#333" padding="15px" border="0">
      <mj-column>
        <mj-text letter-spacing="1px" color="#fff" text-decoration="underline" font-size="16px" align="center" font-family="Arial, sans-serif">
          Web View | Home | Data Privacy | Web View
        </mj-text>
        <mj-text color="#fff" font-size="14px" align="center" line-height="1.5" css-class="dm-text">
          <br /><strong>&copy; Kick Off → Your English</strong><br />
          1 Example Street, Example City, Country<br />
          Tel +00 00 0000 0000
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>